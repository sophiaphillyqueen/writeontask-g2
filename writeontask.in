#!@PERL_PATH@
use strict;
use warnings;

my $soundfile = '@DATADIR@/writeontask-g2/bell-sound-0003.wav';

my $comdir;
if (defined($ENV{XDG_STATE_HOME}) && $ENV{XDG_STATE_HOME} =~ m{^/})
{
  $comdir = "$ENV{XDG_STATE_HOME}/writeontask-g2";
}
else
{
  $comdir = "$ENV{HOME}/.local/state/writeontask-g2";
}

exec('writeontask-g2-util',$comdir,$soundfile,@ARGV);

